---
import '../styles/global.css';
import NavIsland from '../components/NavIsland.jsx';
import SmoothScroll from '../components/SmoothScroll.jsx';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Sean Winslow — Product Manager, Animator, Builder' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Inline theme script to prevent flash -->
    <script is:inline>
      (function() {
        // Read theme from cookie for sandboxed environments
        var match = document.cookie.match(/sw-theme=(light|dark)/);
        var theme = match ? match[1] : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main-content" class="sr-only skip-link">Skip to content</a>

    <NavIsland client:load currentPath={currentPath} />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="site-footer-text">
        &copy; 2026 Sean Winslow. Built with intention.
      </p>
    </footer>

    <SmoothScroll client:load />
  </body>
</html>

<style is:global>
  .site-main {
    padding-top: var(--nav-height);
  }

  .site-footer {
    border-top: 1px solid var(--surface-3);
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 1000;
    background: var(--color-primary);
    color: #fff;
    padding: 8px 16px;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    border-radius: 0 0 var(--radius-button) 0;
    text-decoration: none;
    transition: top 150ms ease;
  }
  .skip-link:focus {
    top: 0;
    clip: auto;
    width: auto;
    height: auto;
    overflow: visible;
    white-space: normal;
    margin: 0;
  }

  .site-footer-text {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--text-tertiary);
  }
</style>
