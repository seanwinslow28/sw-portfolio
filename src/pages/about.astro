---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.jsx';
// ImageSwiper deferred to V5 per DESIGN-SPEC-V4 §10
// import ImageSwiper from '../components/ImageSwiper.jsx';

const swiperCards = [
  { label: 'Illustrated Portrait — Pencil Test' },
  { label: 'Animated Self-Portrait' },
  { label: 'Stylized Digital Painting' },
  { label: 'Ink & Wash Study' },
  { label: 'Character Design Sheet' },
  { label: 'Storyboard Sequence' },
];
---

<BaseLayout title="About — Sean Winslow" description="The story of a creative who learned to think like a product manager.">
  <ScrollReveal client:visible>

    <!-- About Hero -->
    <section class="reveal-section about-hero-section">
      <h1 class="about-title">
        About
      </h1>
      <p class="about-subtitle">
        A creative who learned to think in systems.
      </p>
    </section>

    <!-- Chapter 1: The Artist -->
    <section class="reveal-section about-chapter-section">
      <div class="about-grid">
        <div class="about-chapter-text">
          <div class="about-chapter-label">Chapter 1</div>
          <h2 class="about-chapter-h2">
            The Artist
          </h2>
          <div class="about-body-stack">
            <p class="about-body">
              For twelve years, I paid rent in New York City by drawing things. Illustration, animation, the occasional film storyboard — if it involved telling a visual story, I was probably in the room, drinking cold coffee and trying to hit a deadline. I worked with agencies and independent filmmakers, building a career around the naive but useful belief that craft and clarity are basically the same thing.
            </p>
            <p class="about-body">
              Those years taught me a secret that I didn't have the vocabulary for yet: every creative project is just a product problem in a turtleneck. Who is the audience? What do they need to feel? Why is the budget so small? I was doing product thinking; I just didn't know the corporate buzzwords yet.
            </p>
            <p class="about-body">
              Managing a 2D animation pipeline — storyboards, keyframes, sound design — forces you to think in systems. You're managing dependencies, critical paths, and quality gates. You're running sprints, even if you just call it "trying to finish the scene before Tuesday."
            </p>
          </div>
        </div>
        <div class="about-image-placeholder">
          <span class="about-placeholder-text">Illustration / Animation Work</span>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="about-divider-wrap">
      <div class="about-divider"></div>
    </div>

    <!-- Chapter 2: The Pivot -->
    <section class="reveal-section about-chapter-section">
      <div class="about-grid">
        <div class="about-chapter-text">
          <div class="about-chapter-label">Chapter 2</div>
          <h2 class="about-chapter-h2">
            The Pivot
          </h2>
          <div class="about-body-stack">
            <p class="about-body">
              In 2024, I made a deliberate pivot. The AI wave wasn't just changing how people drew — it was changing what it meant to build products entirely. I realized pretty quickly that the most impactful job wasn't going to be the person drawing the frames, but the person deciding which frames actually needed to be drawn in the first place.
            </p>
            <p class="about-body">
              So I went back to school, kind of. I invested in PM courses, and more importantly, I started building. I created Pocket PM, a GPT-powered assistant, mostly because I needed one and couldn't afford a real consultant. It forced me to figure out API design and user research from the builder's side of the table.
            </p>
            <p class="about-body">
              The pivot wasn't really a departure from creativity — it was just evolution. Product management is creative problem-solving with a spreadsheet. The medium changed, but the mindset stuck around.
            </p>
          </div>
        </div>
        <div class="about-image-placeholder">
          <span class="about-placeholder-text">Pocket PM / Career Transition</span>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="about-divider-wrap">
      <div class="about-divider"></div>
    </div>

    <!-- Chapter 3: The Builder -->
    <section class="reveal-section about-chapter-section">
      <div class="about-grid">
        <div class="about-chapter-text">
          <div class="about-chapter-label">Chapter 3</div>
          <h2 class="about-chapter-h2">
            The Builder
          </h2>
          <div class="about-body-stack">
            <p class="about-body">
              Landing at The Block as an Associate PM finally let me merge both worlds without feeling like I was living a double life. My first major project — Campus 201 — was an education platform redesign that needed exactly what I had: the creative intuition to know how people learn, and the technical rigor to actually ship the thing before we all grew old.
            </p>
            <p class="about-body">
              I've also been building my own systems in parallel. The Superuser Pack — basically a Claude Code command center with over a hundred custom skills — came from my stubborn belief that PMs shouldn't have to wait for engineering cycles just to prototype an idea. And my AI Animation Pipeline is trying to do for 2D animation what the printing press did for books. (Or at least, make it a lot faster.)
            </p>
            <p class="about-body">
              So this is who I am now: someone who thinks in systems, builds with intention, and brings a creative sensibility to the table. The artist didn't disappear. He just learned how to scale.
            </p>
          </div>
        </div>
        <div class="about-image-placeholder">
          <span class="about-placeholder-text">The Block / Builder Setup</span>
        </div>
      </div>
    </section>

    <!-- Image Swiper — art-style portrait card deck (Deferred to V5) -->
    <!-- 
    <section class="reveal-section about-swiper-section">
      <ImageSwiper client:visible cards={swiperCards} />
    </section>
    -->

    <!-- Spacer -->
    <div class="about-spacer"></div>

  </ScrollReveal>
</BaseLayout>

<style is:global>
  /* Hero */
  .about-hero-section {
    padding: var(--space-32) var(--space-6) var(--space-16);
    max-width: var(--text-max-width);
    margin: 0 auto;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--text-display-lh);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .about-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-h3);
    line-height: var(--text-h3-lh);
    font-weight: 400;
    color: var(--text-secondary);
  }

  /* Chapter sections */
  .about-chapter-section {
    padding: var(--space-16) var(--space-6);
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  /* Grid — single column by default, two columns on wider screens */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .about-chapter-text {
    max-width: var(--text-max-width);
  }

  .about-chapter-label {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .about-chapter-h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--text-h2-lh);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-8);
  }

  .about-body-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--text-secondary);
  }

  /* Image placeholder */
  .about-image-placeholder {
    aspect-ratio: 4/3;
    background-color: var(--surface-2);
    border-radius: var(--radius-card);
    border: 1px solid var(--surface-3);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }

  .about-placeholder-text {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--text-tertiary);
  }

  /* Divider */
  .about-divider-wrap {
    max-width: var(--text-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .about-divider {
    border-top: 1px solid var(--surface-3);
  }

  /* Image swiper section */
  .about-swiper-section {
    padding: var(--space-16) var(--space-6) var(--space-24);
    display: flex;
    justify-content: center;
  }

  /* Bottom spacer */
  .about-spacer {
    height: var(--space-16);
  }
</style>
