---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../components/ScrollReveal.jsx';
import TransactionCard from '../../components/TransactionCard.astro';
import { getCollection } from 'astro:content';

const transactions = await getCollection('transactions');
// Sort by reverse chronological order (simple assumption for now, or just use natural order)
const sortedTransactions = transactions.sort((a, b) => {
  // We don't have true dates in this simple mock, just dateline strings, but we can assume they are pre-sorted or parseable if needed.
  return 0; // Keeping natural order for now
});
---

<BaseLayout
  title="Transactions — Sean Winslow"
  description="Small, completed units of work with the explanation attached. The discipline lives at the artifact; this page is the index."
>
  <ScrollReveal client:visible>
    <!-- Hero -->
    <section class="reveal-section transactions-hero-section">
      <h1 class="transactions-title">Transactions</h1>
      <p class="transactions-subtitle">
        The temporary exhibit wing. A weekly log of completed artifacts, agentic collaborations, and the technical reasoning behind them. Read the 4Q deep dives.
      </p>
    </section>

    <!-- Transactions list (Track-listing IA) -->
    <section class="reveal-section transactions-list-section">
      <div class="transactions-list">
        {sortedTransactions.map((t) => (
          <TransactionCard
            slug={t.slug}
            dateline={t.data.dateline}
            beat={t.data.beat}
            title={t.data.title}
            valueProp={t.data.valueProp}
            producedBy={t.data.producedBy}
          />
        ))}
      </div>
    </section>

    <!-- Spacer -->
    <div class="transactions-spacer"></div>
  </ScrollReveal>
</BaseLayout>

<style>
  /* Hero */
  .transactions-hero-section {
    padding: var(--space-32) var(--space-6) var(--space-8);
    max-width: var(--text-max-width);
    margin: 0 auto;
  }

  .transactions-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--text-display-lh);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .transactions-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    font-weight: 400;
    color: var(--text-secondary);
    max-width: 60ch;
  }

  /* List */
  .transactions-list-section {
    padding: var(--space-8) var(--space-6) var(--space-16);
    max-width: var(--text-max-width);
    margin: 0 auto;
  }

  .transactions-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4); /* Album track listing density */
  }

  /* Spacer */
  .transactions-spacer {
    height: var(--space-16);
  }
</style>
